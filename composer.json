{
    "name": "praxleo/appointment-pro",
    "description": "Appointment and scheduling for WordPress.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "keywords": [
        "appointment",
        "booking",
        "scheduling",
        "wordpress"
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Praxleo\\Appointment\\": "inc/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^7.1"
    }
}
